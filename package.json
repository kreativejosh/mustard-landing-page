    "@types/react-dom": "^19",
    "@types/three": "^0.160.0",
    "eslint": "^10",
    "eslint-config-next": "15.5.29",
    "typescript": "^7"
  },
  "overrides": {
    "postcss": "8.5.32",
    "sharp": "0.35.5"
  }
