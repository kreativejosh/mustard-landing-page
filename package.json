  "private": true,
  "scripts": {
    "brand:sync": "node scripts/sync-brand.mjs",
    "brand:verify": "node scripts/verify-brand.mjs",
    "brand:check": "node scripts/brand-check.mjs",
    "predev": "npm run brand:verify",
    "dev": "next dev",
